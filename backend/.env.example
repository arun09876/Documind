DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# Database: leave unset for SQLite, or e.g. postgres://user:pass@localhost:5432/documind
# DATABASE_URL=

# LLM engine: auto = Claude if its key is set, else Gemini if its key is set,
# else local Ollama if running, else extractive
LLM_PROVIDER=auto
# Free key (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
LLM_EFFORT=low

# Embeddings: auto (local BGE via fastembed, hashing fallback) | local | hash
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval tuning
CHUNK_TARGET_CHARS=900
CHUNK_OVERLAP_CHARS=180
RETRIEVAL_TOP_K=6
MAX_UPLOAD_MB=25
